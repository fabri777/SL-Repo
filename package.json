{
  "name": "@fabri777/sl",
  "version": "0.6.0",
  "private": false,
  "description": "Repository-local self-learning lifecycle for GitHub Copilot agents",
  "type": "module",
  "bin": {
    "sl": "dist/SL-src/SL-cli/SL-cli.js"
  },
  "files": [
    "dist",
    "SL-docs",
    "SL-schemas",
    "SL-templates",
    "SL-plugin",
    "SL-tests",
    "sl.ps1",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:runtime",
    "build:ts": "tsc -p tsconfig.json",
    "build:runtime": "node dist/SL-src/SL-runtime/SL-runtime-build.js",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p SL-tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run --config SL-vitest.config.ts",
    "test:runtime": "npm run build && vitest run --config SL-vitest.config.ts SL-tests/SL-unit/SL-runtime-contract.test.ts SL-tests/SL-integration/SL-runtime.test.ts",
    "runtime:conformance": "npm run build && node dist/SL-src/SL-runtime/SL-runtime-conformance.js",
    "test:watch": "vitest",
    "portable:stage": "node dist/SL-src/SL-distribution/SL-package-portable.js",
    "portable:manifest": "node dist/SL-src/SL-distribution/SL-create-release-manifest.js",
    "validate:self": "npm run build && node dist/SL-src/SL-cli/SL-cli.js validate .",
    "ci": "npm run check && npm test"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
