{
  "name": "@microsoft/sl-repo",
  "version": "0.1.0",
  "private": false,
  "description": "Repository-local self-learning lifecycle for GitHub Copilot agents",
  "type": "module",
  "bin": {
    "sl-repo": "dist/SL-src/SL-cli/SL-cli.js"
  },
  "files": [
    "dist",
    "SL-schemas",
    "SL-templates",
    "SL-plugin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p SL-tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run --config SL-vitest.config.ts",
    "test:watch": "vitest",
    "validate:self": "npm run build && node dist/SL-src/SL-cli/SL-cli.js validate .",
    "ci": "npm run check && npm test"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
