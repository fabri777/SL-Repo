{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ffishkel_microsoft/SL/SL-scope-catalog.schema.json",
  "title": "SL hierarchical repository scope catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scopes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "kind",
          "includePaths",
          "excludePaths",
          "dependencyScopeIds",
          "ownerAliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SL-SCOPE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "repository",
              "shared",
              "service",
              "solution",
              "library",
              "package"
            ]
          },
          "includePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excludePaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parentScopeId": {
            "type": "string",
            "pattern": "^SL-SCOPE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "dependencyScopeIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SL-SCOPE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
            }
          },
          "ownerAliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9_.-]*)(?:/[A-Za-z0-9](?:[A-Za-z0-9_.-]*))?$"
            }
          },
          "priority": {
            "type": "integer"
          }
        }
      }
    }
  }
}
