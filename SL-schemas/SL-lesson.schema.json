{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ffishkel_microsoft/SL/SL-lesson.schema.json",
  "title": "SL lesson frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "schemaVersion",
    "managedBy",
    "date",
    "kind",
    "scope",
    "status",
    "trigger",
    "hits",
    "retrievals",
    "lastVerifiedAt",
    "pinned",
    "relatedTo"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
    },
    "schemaVersion": {
      "const": 1
    },
    "managedBy": {
      "const": "SL-Repo"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "kind": {
      "enum": [
        "win",
        "pitfall",
        "mixed"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "raw",
        "distilled",
        "promotion-candidate",
        "promoted",
        "stale",
        "quarantined",
        "superseded"
      ]
    },
    "trigger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "hits": {
      "type": "integer",
      "minimum": 0
    },
    "retrievals": {
      "type": "integer",
      "minimum": 0
    },
    "notUsefulVotes": {
      "type": "integer",
      "minimum": 0
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date"
    },
    "lastRetrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastSuccessfulUseAt": {
      "type": "string",
      "format": "date-time"
    },
    "pinned": {
      "type": "boolean"
    },
    "relatedTo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededBy": {
      "type": "string"
    }
  }
}
