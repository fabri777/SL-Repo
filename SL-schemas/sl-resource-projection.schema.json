{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabri777/SL-Repo/sl-resource-projection.schema.json",
  "title": "SL scope resource projection shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "projections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "$ref": "sl-state-catalog.schema.json#/$defs/scope" },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "phase",
          "source",
          "quality",
          "provider",
          "modelId",
          "receiptCount",
          "inputTokens",
          "outputTokens",
          "cacheReadTokens",
          "cacheWriteTokens",
          "reasoningTokens",
          "totalTokens",
          "wallClockDurationMs",
          "modelDurationMs",
          "toolDurationMs",
          "attemptCount",
          "reportedCosts"
        ],
        "properties": {
          "scope": { "$ref": "sl-state-catalog.schema.json#/$defs/scope" },
          "artifactId": { "type": "string" },
          "artifactVersion": { "type": "string" },
          "artifactContentHash": { "type": "string" },
          "phase": { "enum": ["generation", "application", "baseline"] },
          "source": { "enum": ["host", "ci", "manual"] },
          "quality": { "enum": ["measured", "estimated"] },
          "provider": { "type": "string" },
          "modelId": { "type": "string" },
          "receiptCount": { "type": "integer", "minimum": 0 },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "cacheReadTokens": { "type": "integer", "minimum": 0 },
          "cacheWriteTokens": { "type": "integer", "minimum": 0 },
          "reasoningTokens": { "type": "integer", "minimum": 0 },
          "totalTokens": { "type": "integer", "minimum": 0 },
          "wallClockDurationMs": { "type": "integer", "minimum": 0 },
          "modelDurationMs": { "type": "integer", "minimum": 0 },
          "toolDurationMs": { "type": "integer", "minimum": 0 },
          "attemptCount": { "type": "integer", "minimum": 0 },
          "reportedCosts": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z]{3}$" },
            "additionalProperties": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
            }
          }
        }
      }
    }
  }
}
