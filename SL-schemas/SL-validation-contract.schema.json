{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabri777/SL-Repo/SL-validation-contract.schema.json",
  "title": "SL promoted artifact validation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifact",
    "provenance",
    "scope",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
        },
        "type": {
          "enum": [
            "instruction",
            "skill"
          ]
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIds"
      ],
      "properties": {
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
          }
        },
        "sourcePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "paths"
          ]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPattern"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "paths"
              }
            }
          },
          "then": {
            "required": [
              "paths"
            ]
          },
          "else": {
            "not": {
              "required": [
                "paths"
              ]
            }
          }
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "expectedBehavior"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/checkId"
          },
          "input": {
            "$ref": "#/$defs/jsonValue"
          },
          "expectedBehavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "counterexamples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "expectedBehavior"
              ],
              "properties": {
                "input": {
                  "$ref": "#/$defs/jsonValue"
                },
                "expectedBehavior": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          }
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,127}$"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "override": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "overriddenArtifactId",
              "overriddenScopeId",
              "declarationKey",
              "reason",
              "approvalRef"
            ],
            "properties": {
              "kind": {
                "const": "narrower-scope"
              },
              "overriddenArtifactId": {
                "type": "string",
                "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
              },
              "overriddenScopeId": {
                "$ref": "#/$defs/scopeId"
              },
              "declarationKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{1,127}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "approvalRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "executableChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "arguments",
          "timeoutMs",
          "expectedExitCode"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/checkId"
          },
          "command": {
            "enum": [
              "node",
              "npm"
            ]
          },
          "arguments": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "cwd": {
            "$ref": "#/$defs/repositoryPath"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000
          },
          "expectedExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact": {
            "properties": {
              "type": {
                "const": "instruction"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "executableChecks": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "checkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,127}$"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F]+$"
    },
    "repositoryPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F]+$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
