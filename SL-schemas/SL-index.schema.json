{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/SL-Repo/SL-index.schema.json",
  "title": "SL discovery index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "artifactType",
          "status",
          "relatedTo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "artifactType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "trigger": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hits": {
            "type": "integer",
            "minimum": 0
          },
          "retrievals": {
            "type": "integer",
            "minimum": 0
          },
          "notUsefulVotes": {
            "type": "integer",
            "minimum": 0
          },
          "relatedTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
