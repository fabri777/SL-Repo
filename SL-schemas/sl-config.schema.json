{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ffishkel_microsoft/SL/sl-config.schema.json",
  "title": "SL Repo configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "retention",
    "promotion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "repo"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staleAfterDays",
        "quarantineAfterDays",
        "deleteAfterQuarantineDays",
        "wrongDeleteAfterDays",
        "promotedStaleAfterDays",
        "promotedQuarantineAfterDays"
      ],
      "properties": {
        "staleAfterDays": {
          "type": "integer",
          "minimum": 1
        },
        "quarantineAfterDays": {
          "type": "integer",
          "minimum": 1
        },
        "deleteAfterQuarantineDays": {
          "type": "integer",
          "minimum": 1
        },
        "wrongDeleteAfterDays": {
          "type": "integer",
          "minimum": 1
        },
        "promotedStaleAfterDays": {
          "type": "integer",
          "minimum": 1
        },
        "promotedQuarantineAfterDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "policyVersion",
        "local",
        "shared",
        "approvals",
        "conflicts"
      ],
      "properties": {
        "mode": {
          "enum": [
            "single-repository",
            "monorepo"
          ]
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumVerifiedSuccesses"
          ],
          "properties": {
            "minimumVerifiedSuccesses": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumDistinctNonRootScopes",
            "minimumVerifiedSuccessesPerScope"
          ],
          "properties": {
            "minimumDistinctNonRootScopes": {
              "type": "integer",
              "minimum": 1
            },
            "minimumVerifiedSuccessesPerScope": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requireTargetOwnerApproval"
          ],
          "properties": {
            "requireTargetOwnerApproval": {
              "type": "boolean"
            }
          }
        },
        "conflicts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowNarrowerExplicitOverrides",
            "blockUndeclaredConflicts"
          ],
          "properties": {
            "allowNarrowerExplicitOverrides": {
              "type": "boolean"
            },
            "blockUndeclaredConflicts": {
              "const": true
            }
          }
        }
      }
    }
  }
}
