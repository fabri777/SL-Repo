{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabri777/SL-Repo/sl-registry.schema.json",
  "title": "SL artifact registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "artifactType",
          "classification",
          "managedBy",
          "status",
          "createdAt",
          "lastVerifiedAt",
          "pinned",
          "relatedTo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "originalPath": {
            "type": "string"
          },
          "previousStatus": {
            "enum": [
              "raw",
              "distilled",
              "promotion-candidate",
              "generated",
              "probation",
              "promoted",
              "stale",
              "quarantined",
              "superseded",
              "deleted",
              "active"
            ]
          },
          "artifactType": {
            "enum": [
              "lesson",
              "instruction",
              "skill",
              "system"
            ]
          },
          "classification": {
            "enum": [
              "system",
              "evidence",
              "promoted"
            ]
          },
          "managedBy": {
            "const": "sl"
          },
          "status": {
            "enum": [
              "raw",
              "distilled",
              "promotion-candidate",
              "generated",
              "probation",
              "promoted",
              "stale",
              "quarantined",
              "superseded",
              "deleted",
              "active"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastRetrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSuccessfulUseAt": {
            "type": "string",
            "format": "date-time"
          },
          "staleAt": {
            "type": "string",
            "format": "date-time"
          },
          "quarantinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleteEligibleAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "activatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "promotionTargetPath": {
            "type": "string"
          },
          "promotionEvaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "status",
              "artifactVersion",
              "artifactContentHash",
              "contractContentHash",
              "evaluatedAt",
              "gates"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "artifactVersion": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "artifactContentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "contractContentHash": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "evaluatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status",
                    "message"
                  ],
                  "properties": {
                    "id": {
                      "enum": [
                        "contract",
                        "provenance",
                        "static-scenarios",
                        "active-conflicts",
                        "executable-checks",
                        "repository-approval",
                        "scope-evidence",
                        "owner-approval",
                        "scoped-conflicts",
                        "policy-current",
                        "content-unchanged"
                      ]
                    },
                    "status": {
                      "enum": [
                        "passed",
                        "failed"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "approvalEvidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "evidenceRef"
                ],
                "properties": {
                  "kind": {
                    "const": "repository-review"
                  },
                  "evidenceRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "governance": {
                "$ref": "#/$defs/promotionGovernance"
              }
            }
          },
          "usageProjection": {
            "$ref": "#/$defs/usageProjection"
          },
          "pinned": {
            "type": "boolean"
          },
          "relatedTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forgetReason": {
            "enum": [
              "wrong",
              "irrelevant",
              "superseded",
              "unused"
            ]
          },
          "scope": {
            "$ref": "#/$defs/scope"
          }
        }
      }
    }
  },
  "$defs": {
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
    },
    "artifactVersion": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "opaqueReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "promotionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "root",
        "precedence",
        "ancestorScopeIds",
        "ownerSetId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/scopeId"
        },
        "kind": {
          "enum": [
            "repository",
            "shared",
            "solution",
            "service",
            "library",
            "package"
          ]
        },
        "root": {
          "type": "boolean"
        },
        "precedence": {
          "type": "integer",
          "minimum": 0
        },
        "ancestorScopeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scopeId"
          }
        },
        "ownerSetId": {
          "$ref": "#/$defs/scopeId"
        }
      }
    },
    "overrideMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "overriddenArtifactId",
        "overriddenScopeId",
        "declarationKey",
        "reason",
        "approvalRef"
      ],
      "properties": {
        "kind": {
          "const": "narrower-scope"
        },
        "overriddenArtifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "overriddenScopeId": {
          "$ref": "#/$defs/scopeId"
        },
        "declarationKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "approvalRef": {
          "$ref": "#/$defs/opaqueReference"
        }
      }
    },
    "promotionGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "policyVersion",
        "policyHash",
        "inputHash",
        "targetScope",
        "sourceScopes",
        "artifactScope",
        "evidenceSummary",
        "ownerApprovals",
        "conflictResolutions",
        "reasons"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetScope": {
          "$ref": "#/$defs/promotionScope"
        },
        "sourceScopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId",
              "artifactVersion",
              "scope"
            ],
            "properties": {
              "artifactId": {
                "$ref": "#/$defs/artifactId"
              },
              "artifactVersion": {
                "$ref": "#/$defs/artifactVersion"
              },
              "scope": {
                "$ref": "#/$defs/promotionScope"
              }
            }
          }
        },
        "artifactScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactId",
            "scope"
          ],
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/artifactId"
            },
            "scope": {
              "$ref": "#/$defs/promotionScope"
            }
          }
        },
        "evidenceSummary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceArtifactId",
              "artifactVersion",
              "scopeId",
              "verifiedSuccessCount",
              "verifiedFailureCount",
              "evidenceRefs"
            ],
            "properties": {
              "sourceArtifactId": {
                "$ref": "#/$defs/artifactId"
              },
              "artifactVersion": {
                "$ref": "#/$defs/artifactVersion"
              },
              "scopeId": {
                "$ref": "#/$defs/scopeId"
              },
              "verifiedSuccessCount": {
                "type": "integer",
                "minimum": 0
              },
              "verifiedFailureCount": {
                "type": "integer",
                "minimum": 0
              },
              "evidenceRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/opaqueReference"
                }
              }
            }
          }
        },
        "ownerApprovals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "scopeId",
              "ownerSetId",
              "evidenceRef"
            ],
            "properties": {
              "kind": {
                "const": "owner-set-approval"
              },
              "scopeId": {
                "$ref": "#/$defs/scopeId"
              },
              "ownerSetId": {
                "$ref": "#/$defs/scopeId"
              },
              "evidenceRef": {
                "$ref": "#/$defs/opaqueReference"
              }
            }
          }
        },
        "repositoryApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidenceRef"
          ],
          "properties": {
            "kind": {
              "const": "repository-review"
            },
            "evidenceRef": {
              "$ref": "#/$defs/opaqueReference"
            }
          }
        },
        "conflictResolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declarationKey",
              "narrowerArtifactId",
              "broaderArtifactId",
              "status",
              "message"
            ],
            "properties": {
              "declarationKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{1,127}$"
              },
              "narrowerArtifactId": {
                "$ref": "#/$defs/artifactId"
              },
              "broaderArtifactId": {
                "$ref": "#/$defs/artifactId"
              },
              "status": {
                "enum": [
                  "explicit-override",
                  "blocked"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "override": {
                "$ref": "#/$defs/overrideMetadata"
              }
            }
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "usageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifactId",
        "artifactVersion",
        "artifactContentHash",
        "retrievalCount",
        "applicationCount",
        "applicationRate",
        "outcomeCount",
        "outcomeSuccessCount",
        "outcomeFailureCount",
        "outcomePartialCount",
        "outcomeUnknownCount",
        "outcomeSuccessRate",
        "verifiedCount",
        "resolvedCount",
        "verifiedSuccessCount",
        "verifiedFailureCount",
        "unknownCount",
        "verifiedSuccessRate"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
        },
        "artifactVersion": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "artifactContentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrievalCount": {
          "type": "integer",
          "minimum": 0
        },
        "applicationCount": {
          "type": "integer",
          "minimum": 0
        },
        "applicationRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "outcomeCount": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeSuccessCount": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeFailureCount": {
          "type": "integer",
          "minimum": 0
        },
        "outcomePartialCount": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeUnknownCount": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeSuccessRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "verifiedCount": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedSuccessCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedFailureCount": {
          "type": "integer",
          "minimum": 0
        },
        "unknownCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedSuccessRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "lastRetrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastAppliedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastVerifiedSuccessAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastVerifiedFailureAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
