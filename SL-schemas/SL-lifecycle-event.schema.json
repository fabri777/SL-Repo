{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ffishkel_microsoft/SL/SL-lifecycle-event.schema.json",
  "title": "SL immutable lifecycle event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "idempotencyKey",
    "timestamp",
    "artifactId",
    "action"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^SL-EVENT-[A-F0-9]{32}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
    },
    "action": {
      "enum": [
        "registered",
        "captured",
        "voted",
        "promoted",
        "promotion-registered",
        "promotion-evaluated",
        "promotion-invalidated",
        "activated",
        "marked-stale",
        "quarantined",
        "restored",
        "deleted"
      ]
    },
    "reason": {
      "type": "string"
    },
    "fromStatus": {
      "type": "string"
    },
    "toStatus": {
      "type": "string"
    },
    "fromPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "toPath": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
