{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabri777/SL-Repo/SL-registry.schema.json",
  "title": "SL artifact registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "artifactType",
          "classification",
          "managedBy",
          "status",
          "createdAt",
          "lastVerifiedAt",
          "pinned",
          "relatedTo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
          },
          "path": {
            "type": ["string", "null"]
          },
          "originalPath": {
            "type": "string"
          },
          "previousStatus": {
            "enum": [
              "raw",
              "distilled",
              "promotion-candidate",
              "generated",
              "probation",
              "promoted",
              "stale",
              "quarantined",
              "superseded",
              "deleted",
              "active"
            ]
          },
          "artifactType": {
            "enum": ["lesson", "instruction", "skill", "system"]
          },
          "classification": {
            "enum": ["system", "evidence", "promoted"]
          },
          "managedBy": {
            "const": "SL-Repo"
          },
          "status": {
            "enum": [
              "raw",
              "distilled",
              "promotion-candidate",
              "generated",
              "probation",
              "promoted",
              "stale",
              "quarantined",
              "superseded",
              "deleted",
              "active"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastRetrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSuccessfulUseAt": {
            "type": "string",
            "format": "date-time"
          },
          "hits": {
            "type": "integer",
            "minimum": 0
          },
          "retrievals": {
            "type": "integer",
            "minimum": 0
          },
          "notUsefulVotes": {
            "type": "integer",
            "minimum": 0
          },
          "staleAt": {
            "type": "string",
            "format": "date-time"
          },
          "quarantinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleteEligibleAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "activatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "promotionTargetPath": {
            "type": "string"
          },
          "promotionEvaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "status",
              "artifactVersion",
              "artifactContentHash",
              "contractContentHash",
              "evaluatedAt",
              "gates"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "status": {
                "enum": ["passed", "failed"]
              },
              "artifactVersion": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "artifactContentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "contractContentHash": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "evaluatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "status", "message"],
                  "properties": {
                    "id": {
                      "enum": [
                        "contract",
                        "provenance",
                        "static-scenarios",
                        "active-conflicts",
                        "executable-checks",
                        "repository-approval",
                        "content-unchanged"
                      ]
                    },
                    "status": {
                      "enum": ["passed", "failed"]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "approvalEvidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "evidenceRef"],
                "properties": {
                  "kind": {
                    "const": "repository-review"
                  },
                  "evidenceRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          },
          "usageProjection": {
            "$ref": "#/$defs/usageProjection"
          },
          "pinned": {
            "type": "boolean"
          },
          "relatedTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forgetReason": {
            "enum": [
              "wrong",
              "irrelevant",
              "superseded",
              "unused"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "usageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactVersion",
        "artifactContentHash",
        "retrievalCount",
        "applicationCount",
        "resolvedCount",
        "verifiedSuccessCount",
        "verifiedFailureCount",
        "unknownCount",
        "verifiedSuccessRate"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^SL-[A-Z0-9][A-Z0-9-]*$"
        },
        "artifactVersion": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "artifactContentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrievalCount": {
          "type": "integer",
          "minimum": 0
        },
        "applicationCount": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedSuccessCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedFailureCount": {
          "type": "integer",
          "minimum": 0
        },
        "unknownCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedSuccessRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "lastRetrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastAppliedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastVerifiedSuccessAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastVerifiedFailureAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
